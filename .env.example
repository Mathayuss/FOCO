# FOCO — ambiente de desenvolvimento
VERSAO_FOCO=0.3.1
AMBIENTE=desenvolvimento

# PostgreSQL/PostGIS
BD_USUARIO=foco
BD_SENHA=altere_esta_senha
BD_NOME=foco_ocorrencias
DATABASE_URL=postgresql+psycopg://foco:altere_esta_senha@bd:5432/foco_ocorrencias

# Interface/API
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1|0\.0\.0\.0|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2\d|3[0-1])\.\d+\.\d+|100\.\d+\.\d+\.\d+):5173
VITE_API_URL=http://localhost:8000/api/v1

# Importação
LIMITE_IMPORTACAO_MB=512
