[Unit]
Description=FOCO - Aplicacao Docker Compose
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
RequiresMountsFor=/home/administrador/foco

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/administrador/foco
ExecStart=/usr/bin/docker compose --project-name foco up -d --wait --wait-timeout 120
ExecStop=/usr/bin/docker compose --project-name foco stop --timeout 30
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
